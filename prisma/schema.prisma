// Design Sportswear — data model
// Quote-request e-commerce (no cart / no checkout) + Shopify-style admin + block page builder.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- auth

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  /// Areas of the admin this account may use. Ignored for ADMIN, who sees all.
  permissions  Json?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------- media

model Media {
  id        String   @id @default(cuid())
  url       String   @db.VarChar(512)
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String   @default("")
  folder    String   @default("general")
  createdAt DateTime @default(now())

  productImages ProductImage[]

  @@index([folder])
  @@map("media")
}

// ---------------------------------------------------------------- catalog

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Collection {
  id          String        @id @default(cuid())
  handle      String        @unique
  title       String
  subtitle    String?       @db.Text
  description String?       @db.Text
  bannerUrl   String?       @db.VarChar(512)
  thumbUrl    String?       @db.VarChar(512)
  status      PublishStatus @default(PUBLISHED)
  position    Int           @default(0)
  showInNav   Boolean       @default(true)

  seoTitle       String?
  seoDescription String? @db.Text

  // Optional page-builder blocks appended under the product grid
  blocks Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductCollection[]

  @@index([status, position])
  @@map("collections")
}

model Product {
  id            String        @id @default(cuid())
  handle        String        @unique
  title         String
  subtitle      String?
  description   String        @db.Text
  basePrice     Decimal       @db.Decimal(10, 2)
  compareAt     Decimal?      @db.Decimal(10, 2)
  badge         String?
  categoryLabel String        @default("Fully customizable")
  status        PublishStatus @default(PUBLISHED)
  featured      Boolean       @default(false)
  position      Int           @default(0)
  sku           String?

  // Structured, admin-editable JSON
  sports      Json? // ["Baseball","Softball","Other"]
  colorways   Json? // [{name,from,to}]
  sizes       Json? // ["YS","YM",...]
  defaultQty  Json? // {"S":2,"M":4,...}
  volumeTiers Json? // [{label,minQty,maxQty,discount,savingsLabel}]
  specs       Json? // [{q,a}]
  trustPoints Json? // ["No deposit to get a quote", ...]

  seoTitle       String?
  seoDescription String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images      ProductImage[]
  collections ProductCollection[]
  quotes      QuoteRequest[]

  @@index([status, position])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  mediaId   String?
  url       String  @db.VarChar(512)
  alt       String  @default("")
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([mediaId])
  @@map("product_images")
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collections")
}

// ---------------------------------------------------------------- team packages

model TeamPackage {
  id        String        @id @default(cuid())
  handle    String        @unique
  tag       String
  name      String
  price     Decimal       @db.Decimal(10, 2)
  note      String?
  items     Json // string[]
  imageUrl  String?       @db.VarChar(512)
  highlight Boolean       @default(false)
  position  Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("team_packages")
}

// ---------------------------------------------------------------- content

model Review {
  id        String   @id @default(cuid())
  text      String   @db.Text
  name      String
  role      String
  initials  String
  rating    Int      @default(5)
  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Faq {
  id        String  @id @default(cuid())
  question  String  @db.Text
  answer    String  @db.Text
  group     String  @default("home") // home | product | contact
  published Boolean @default(true)
  position  Int     @default(0)

  @@index([group, position])
  @@map("faqs")
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  blocks         Json // Block[] — rendered by the block registry
  status         PublishStatus @default(PUBLISHED)
  isSystem       Boolean       @default(false)
  showInNav      Boolean       @default(false)
  navLabel       String?
  position       Int           @default(0)
  seoTitle       String?
  seoDescription String?       @db.Text
  ogImage        String?       @db.VarChar(512)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  revisions PageRevision[]

  @@map("pages")
}

model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  blocks    Json
  label     String?
  authorId  String?
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("page_revisions")
}

model NavItem {
  id       String  @id @default(cuid())
  menu     String // header | footer_shop | footer_company
  label    String
  href     String
  position Int     @default(0)
  newTab   Boolean @default(false)

  @@index([menu, position])
  @@map("nav_items")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------- leads

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUOTED
  WON
  LOST
}

model QuoteRequest {
  id         String  @id @default(cuid())
  reference  String  @unique
  subject    String
  team       String
  name       String
  phone      String
  email      String
  sport      String?
  rosterSize Int?
  deadline   String?
  message    String? @db.Text

  // product context (when opened from a PDP)
  productId    String?
  productTitle String?
  colorway     String?
  sizeRun      Json?
  totalUnits   Int?
  unitPrice    Decimal? @db.Decimal(10, 2)
  estTotal     Decimal? @db.Decimal(10, 2)
  attachments  Json?

  status     LeadStatus @default(NEW)
  source     String     @default("site")
  pageUrl    String?    @db.VarChar(512)
  referrer   String?    @db.VarChar(512)
  utm        Json?
  adminNotes String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([productId])
  @@map("quote_requests")
}

model ContactMessage {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String     @db.Text
  status    LeadStatus @default(NEW)
  pageUrl   String?    @db.VarChar(512)
  createdAt DateTime   @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

/**
 * The bytes of every uploaded file, keyed by the public path it is served from.
 * The filesystem does not survive a rebuild or redeploy on most hosts, which
 * silently destroys everything the client has uploaded. The database does
 * survive, so it is the authority here; disk is only a cache that is refilled
 * on demand.
 */
model UploadedFile {
  path      String   @id @db.VarChar(512)
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("uploaded_files")
}

// ---------------------------------------------------------------- team stores
//
// A team store is a small, self-contained shop at its own URL (for example
// /mid-illini-bandits): the team's designs, an add-to-cart flow, per-item
// personalisation and a PayPal checkout. Separate from the quote catalogue,
// which sells nothing directly.

enum StoreStatus {
  DRAFT
  OPEN
  CLOSED
}

model TeamStore {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  intro          String?     @db.Text
  logoUrl        String?     @db.VarChar(512)
  heroUrl        String?     @db.VarChar(512)
  accent         String?     @db.VarChar(16)
  status         StoreStatus @default(DRAFT)
  opensAt        DateTime?
  closesAt       DateTime?
  passcode       String?     @db.VarChar(64)
  shipNote       String?     @db.Text
  contactNote    String?     @db.Text
  seoTitle       String?
  seoDescription String?     @db.Text

  items      TeamStoreItem[]
  categories StoreCategory[]
  orders     StoreOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_stores")
}

model StoreCategory {
  id       String        @id @default(cuid())
  storeId  String
  store    TeamStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  position Int           @default(0)

  items TeamStoreItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
  @@map("store_categories")
}

model TeamStoreItem {
  id          String        @id @default(cuid())
  storeId     String
  store       TeamStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  categoryRef StoreCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  category    String        @default("Apparel")
  description String?       @db.Text
  price       Decimal       @db.Decimal(10, 2)
  images      Json?
  sizes       Json?
  options     Json?
  allowName   Boolean       @default(true)
  namePrice   Decimal       @default(0) @db.Decimal(10, 2)
  allowNumber Boolean       @default(true)
  numberPrice Decimal       @default(0) @db.Decimal(10, 2)
  position    Int           @default(0)
  status      PublishStatus @default(PUBLISHED)

  orderItems StoreOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@map("team_store_items")
}

enum StoreOrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model StoreOrder {
  id           String           @id @default(cuid())
  reference    String           @unique
  storeId      String
  store        TeamStore        @relation(fields: [storeId], references: [id])
  customerName String
  email        String
  phone        String?
  shipTo       Json?
  notes        String?          @db.Text
  subtotal     Decimal          @db.Decimal(10, 2)
  shipping     Decimal          @default(0) @db.Decimal(10, 2)
  total        Decimal          @db.Decimal(10, 2)
  currency     String           @default("USD") @db.VarChar(8)
  status       StoreOrderStatus @default(PENDING)

  paypalOrderId   String? @unique @db.VarChar(64)
  paypalCaptureId String? @db.VarChar(64)
  paidAt          DateTime?

  items StoreOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("store_orders")
}

model StoreOrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        StoreOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String?
  item         TeamStoreItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName     String
  size         String?        @db.VarChar(32)
  nameOnItem   String?        @db.VarChar(64)
  numberOnItem String?        @db.VarChar(8)
  options      Json?
  quantity     Int            @default(1)
  unitPrice    Decimal        @db.Decimal(10, 2)
  lineTotal    Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@map("store_order_items")
}
