# ---- Database (MySQL) ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode special characters in the password: * = %2A, @ = %40, # = %23, / = %2F
#
# Hostinger: use the srvNNN.hstgr.io hostname when connecting from outside,
# or "localhost" when the app runs on the same Hostinger server.
# DATABASE_URL="mysql://u1234_user:PASS@srv777.hstgr.io:3306/u1234_dbname"
DATABASE_URL="mysql://root:password@localhost:3306/design_sportswear"

# ---- Auth ----
# Any long random string. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- Seeded admin account ----
ADMIN_EMAIL="admin@design-sportswear.com"
ADMIN_PASSWORD="ChangeMe123!"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Optional: SMTP for quote/contact notifications ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="info@design-sportswear.com"
