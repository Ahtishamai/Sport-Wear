# ---- Database (MySQL) ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode special characters in the password:
#   * %2A   @ %40   # %23   / %2F   ? %3F   : %3A   $ %24   & %26
#
# Hostinger: use the srvNNN.hstgr.io hostname when connecting from outside,
# or "localhost" when the app runs on the same Hostinger server.
# DATABASE_URL="mysql://u1234_user:PASS@srv1235.hstgr.io:3306/u1234_dbname"
# Pool tuning matters on shared hosting, where the account has a
# MAX_CONNECTIONS_PER_HOUR quota. Run `npm run db:limits` to see yours.
#   connection_limit  connections held open per Node process (default: cpus*2+1)
#   pool_timeout      seconds to wait for a free connection before failing
#   connect_timeout   seconds to wait for the initial TCP/auth handshake
DATABASE_URL="mysql://root:password@localhost:3306/design_sportswear?connection_limit=5&pool_timeout=20&connect_timeout=15"

# ---- Auth ----
# Any long random string. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- Seeded admin account ----
ADMIN_EMAIL="admin@design-sportswear.com"
ADMIN_PASSWORD="ChangeMe123!"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Optional: SMTP for quote/contact notifications ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="info@design-sportswear.com"
